@@ -27,6 +27,39 @@
 
 #include "hal.h"
 
+/* Flash program/erase must keep executing while the flash array is busy, so
+ * these routines and their busy-wait are linked into .ramtext (copied to SRAM by
+ * crt0). Running from flash here stalls instruction/vector fetch during the
+ * program/erase, delaying the SPI0 DMA completion IRQ enough to lose a WFI-idle
+ * wakeup on the flash-LCD branches. See keyboards/a_jazz/ak820pro readme. */
+#define SN32_EFL_RAMFUNC __attribute__((section(".ramtext"), noinline, used))
+
+/* Mask interrupts across the window where the flash array is BUSY.
+ *
+ * The .ramtext move above keeps these routines executing while the array is
+ * busy, but it does nothing for interrupt handlers -- the vector table and
+ * every ISR still live in flash. The AK820 Pro runs ~18,800 RGB row
+ * interrupts/s plus a 20 kHz GPT tick, so an interrupt landing inside a
+ * program window is not unlikely, it is essentially certain; the CPU then
+ * fetches a vector and handler out of an array that is mid-program.
+ *
+ * That is the residual hang: board dead, one LED row stuck lit (the row ISR
+ * being one of the victims), recoverable only by a power cycle. Draining the
+ * LCD DMA first -- backing_store_pre_write_hook() on the board side -- was
+ * necessary but not sufficient, because the DMA was never the whole story.
+ *
+ * SCOPE IS DELIBERATE: this masks the per-line PROGRAM window only, which is
+ * tens of microseconds. Sector ERASE is left alone on purpose -- it is
+ * milliseconds, and masking that long starves UART2, which on this board
+ * carries the CH582F link and is the one peripheral where being late means
+ * LOSING DATA (see the interrupt priority table). Trading a rare hang for
+ * routinely corrupted Bluetooth frames would be a bad deal.
+ *
+ * PRIMASK is saved and restored rather than blindly re-enabled, so this is
+ * safe if a caller is already inside a critical section. */
+#define SN32_EFL_CRIT_ENTER()  uint32_t _efl_primask = __get_PRIMASK(); __disable_irq()
+#define SN32_EFL_CRIT_EXIT()   __set_PRIMASK(_efl_primask)
+
 #if (HAL_USE_EFL == TRUE) || defined(__DOXYGEN__)
 
 /*===========================================================================*/
@@ -82,7 +115,7 @@ static inline void sn32_flash_clear_status(EFlashDriver *eflp) {
   eflp->flash->STATUS_b.ERR = 0;
 }
 
-static inline void sn32_flash_wait_busy(EFlashDriver *eflp) {
