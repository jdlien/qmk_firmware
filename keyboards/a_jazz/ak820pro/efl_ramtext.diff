+        {
+            SN32_EFL_CRIT_ENTER();
+            sn32_flash_start_pgm(devp);
+            sn32_flash_wait_busy(devp);
+            SN32_EFL_CRIT_EXIT();
+        }
 
         if (devp->flash->STATUS & SN32_FLASH_STATUS_ERROR) {
             sn32_flash_clear_status(devp);
